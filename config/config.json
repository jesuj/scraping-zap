{
  "$comment": "Configuracion unica del sistema. Agregar una tienda = agregar un objeto en 'stores'. Solo calzado de HOMBRE.",

  "targetSizes": {
    "$comment": "Tallas objetivo en escala US hombre. El pie declarado es de 30 cm.",
    "system": "US_MEN",
    "labels": ["11", "11.5", "12"],
    "footLengthCm": 30
  },

  "scrape": {
    "$comment": "Se guardan TODOS los SKUs de las tallas objetivo (con y sin stock) para que el historial de precios tenga sentido. El filtro de stock se aplica al mostrar.",
    "pageSize": 50,
    "concurrency": 4,
    "minDelayMs": 120,
    "requestTimeoutMs": 30000,
    "maxRetries": 4,
    "userAgent": "scraping-zap/1.0 (uso personal; contacto: cambiar-por-tu-email)"
  },

  "stores": [
    {
      "slug": "fairplay",
      "name": "Fair Play",
      "enabled": true,
      "platform": "vtex",
      "baseUrl": "https://www.fairplay.com.bo",
      "currency": "BOB",
      "vtex": {
        "sizeFieldName": "TALLA",
        "categories": [{ "path": "/47/54/", "label": "HOMBRE / ZAPATILLAS" }]
      }
    },
    {
      "slug": "yuth",
      "name": "Yuth",
      "enabled": true,
      "platform": "vtex",
      "baseUrl": "https://www.yuth.com.bo",
      "currency": "BOB",
      "vtex": {
        "sizeFieldName": "TALLA",
        "categories": [{ "path": "/47/54/", "label": "HOMBRE / ZAPATILLAS" }]
      }
    },
    {
      "slug": "impulse",
      "name": "Impulse",
      "enabled": true,
      "platform": "magento",
      "baseUrl": "https://impulse.bo",
      "currency": "BOB",
      "$scrapeComment": "Su GraphQL es lento (15-25s por pagina) y limita el ritmo con HTTP 507 si se lo apura. Estos valores conservadores tardan ~12 min pero completan; con los globales daba timeout. No subir la concurrencia.",
      "scrape": {
        "pageSize": 20,
        "requestTimeoutMs": 90000,
        "concurrency": 1,
        "minDelayMs": 800
      },
      "magento": {
        "graphqlPath": "/graphql",
        "sizeAttribute": "talla_calzado",
        "categories": [{ "id": "59", "label": "HOMBRE / CALZADO" }]
      }
    },
    {
      "slug": "taf",
      "name": "TAF",
      "enabled": true,
      "platform": "woocommerce",
      "baseUrl": "https://taf.com.bo",
      "currency": "BOB",
      "woocommerce": {
        "sizeAttribute": "attribute_pa_talla",
        "categories": [{ "path": "/categoria/hombre/zapatillas/", "label": "HOMBRE / ZAPATILLAS" }],
        "brandArchives": [
          { "path": "/marca/nike/", "brand": "NIKE" },
          { "path": "/marca/jordan/", "brand": "JORDAN" },
          { "path": "/marca/adidas/", "brand": "ADIDAS" },
          { "path": "/marca/new-balance/", "brand": "NEW BALANCE" },
          { "path": "/marca/puma/", "brand": "PUMA" },
          { "path": "/marca/converse/", "brand": "CONVERSE" },
          { "path": "/marca/veja/", "brand": "VEJA" }
        ],
        "maxPages": 25
      }
    },
    {
      "slug": "marathon",
      "name": "Marathon",
      "enabled": true,
      "platform": "hybris",
      "baseUrl": "https://www.marathon.store",
      "currency": "BOB",
      "hybris": {
        "listPath": "/bo/productos/c/marathonProducts",
        "sizeFacet": "sizeFootwear",
        "genderPrefix": "H",
        "maxPages": 12
      }
    }
  ],

  "web": {
    "port": 4321,
    "host": "127.0.0.1"
  }
}
